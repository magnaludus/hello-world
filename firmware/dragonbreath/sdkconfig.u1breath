# U1 Breath board overlay (Seeed XIAO ESP32-C3).
# Build with:
#   idf.py -B build-u1breath \
#     -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.u1breath" build
CONFIG_PB_BOARD_U1BREATH=y

# The XIAO's GPIO18/19 are not used by the heater, so the native USB
# Serial/JTAG port is the console and the flashing port.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The Panda "Power" LED on GPIO21 does not exist on this board.
# CONFIG_PB_POWER_LED is not set
